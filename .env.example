# Copy this file to .env and fill in real values
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=submanager
POSTGRES_USER=submanager_user
POSTGRES_PASSWORD=changeme_strong_password

# Derived connection string (used by the API container)
DATABASE_URL=postgresql://submanager_user:changeme_strong_password@db:5432/submanager

# API
JWT_SECRET=replace_with_a_long_random_secret
PORT=3001
